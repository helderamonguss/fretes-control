generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleStatus {
  AVAILABLE
  IN_TRANSIT
  MAINTENANCE
  INACTIVE
}

enum FreightStatus {
  SCHEDULED
  PICKUP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Driver {
  id          String   @id @default(cuid())
  name        String
  cpf         String?  @unique
  phone       String?
  license     String?
  licenseType String?
  licenseDue  DateTime?
  active      Boolean  @default(true)
  vehicles    Vehicle[]
  freights    Freight[]
  createdAt   DateTime @default(now())
}

model Client {
  id        String    @id @default(cuid())
  name      String
  document  String?
  phone     String?
  email     String?
  address   String?
  freights  Freight[]
  createdAt DateTime  @default(now())
}

model Vehicle {
  id           String        @id @default(cuid())
  plate        String        @unique
  brand        String?
  model        String?
  year         Int?
  type         String?
  capacityKg   Float?
  mileageKm    Float         @default(0)
  status       VehicleStatus @default(AVAILABLE)
  driverId     String?
  driver       Driver?       @relation(fields: [driverId], references: [id])
  freights     Freight[]
  locations    Location[]
  maintenances Maintenance[]
  createdAt    DateTime      @default(now())
}

model Freight {
  id              String        @id @default(cuid())
  number          String        @unique
  clientId        String
  vehicleId       String?
  driverId        String?
  origin          String
  destination     String
  cargo           String?
  weightKg        Float?
  freightValue    Float         @default(0)
  tollCost        Float         @default(0)
  fuelCost        Float         @default(0)
  otherCost       Float         @default(0)
  pickupAt        DateTime?
  estimatedAt     DateTime?
  deliveredAt     DateTime?
  status          FreightStatus @default(SCHEDULED)
  client          Client        @relation(fields: [clientId], references: [id])
  vehicle         Vehicle?      @relation(fields: [vehicleId], references: [id])
  driver          Driver?       @relation(fields: [driverId], references: [id])
  locations       Location[]
  createdAt       DateTime      @default(now())
}

model Location {
  id        String   @id @default(cuid())
  vehicleId String
  freightId String?
  latitude  Float
  longitude Float
  speed     Float?
  recordedAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  freight   Freight? @relation(fields: [freightId], references: [id], onDelete: SetNull)
  @@index([vehicleId, recordedAt])
}

model Maintenance {
  id          String   @id @default(cuid())
  vehicleId   String
  description String
  cost        Float    @default(0)
  mileageKm   Float?
  scheduledAt DateTime?
  completedAt DateTime?
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}
